# Local onboarding sandbox + auth fixtures. May contain REAL OAuth tokens copied
# from $HOME (see scripts/onboarding_sandbox.sh seed-real-logins). Never commit.
/.env
/.env.local
/.tmp/
/.rayu/generated-images/
/telemetry-worker/backups/
target-ttest/
target-ttest*/

# Local capture artefacts are not committed baselines.
captures/

# Stray experiment/debug artifacts at the repo root. Real assets live under
# assets/, docs/, and tests/ and are committed explicitly.
/*.log
/*.avif
/*.mp4
/*.png
/brag-output/
/.rayu-local/


# Impeccable runtime dirs (shared artifacts stay committed)
.impeccable/review/
.impeccable/mocks/
.impeccable/questions/
.impeccable/config.local.json
.DS_Store

# RayuCode Desktop build outputs & swarm verification logs
desktop/dist/
desktop/dist-electron/
desktop/release/
desktop/resources/bin/
desktop/.run/
.swarm-logs/
