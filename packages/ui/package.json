{
  "name": "@rayu-dev/rayucode-ui",
  "version": "0.1.0",
  "description": "Shared React/TypeScript UI component system, theme tokens, and harness state engine for RayuCode Web (Next.js) and VS Code Extension",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind-preset": {
      "types": "./dist/styles/tailwind.preset.d.ts",
      "default": "./dist/styles/tailwind.preset.js"
    },
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/components.css": "./dist/styles/components.css",
    "./styles/themes/web.css": "./dist/styles/themes/web.css",
    "./styles/themes/vscode.css": "./dist/styles/themes/vscode.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.ts",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@rayu-dev/rayucode-sdk": "1.2.0",
    "diff": "^7.0.0",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
