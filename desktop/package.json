{
  "name": "@rayu-dev/rayucode-desktop",
  "productName": "RayuCode",
  "desktopName": "rayucode.desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:electron": "pnpm build && node scripts/brand-dev-electron-mac.mjs && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint src electron",
    "lint:fix": "eslint --fix src electron",
    "lint:design": "node scripts/lint-design.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"require('fs').copyFileSync('electron/preload.cjs','dist-electron/preload.cjs')\"",
    "build": "pnpm build:renderer && pnpm build:electron",
    "stage:binary": "node scripts/stage-rayu-binary.mjs",
    "package:mac": "pnpm stage:binary && pnpm build && pnpm dlx electron-builder --config electron-builder.yml --mac --publish=never",
    "package:win": "pnpm stage:binary && pnpm build && pnpm dlx electron-builder --config electron-builder.yml --win --publish=never",
    "package:linux": "pnpm stage:binary && pnpm build && pnpm dlx electron-builder --config electron-builder.yml --linux --publish=never",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:design && pnpm test && pnpm build"
  },
  "dependencies": {
    "@rayu-dev/rayucode-sdk": "1.2.0",
    "@rayu-dev/rayucode-session-core": "0.1.0",
    "@rayu-dev/rayucode-ui": "0.1.0",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-virtual": "^3.14.26",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.77.0",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "unified": "^11.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
