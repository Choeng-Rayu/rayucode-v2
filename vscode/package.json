{
  "name": "@rayu-dev/rayucode-vscode",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:webview": "vite --port 5174",
    "typecheck": "tsc --noEmit",
    "lint:design": "node scripts/lint-design.mjs",
    "test:host": "esbuild test/harnessSession.test.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/harnessSession.test.mjs && esbuild test/rayuHostAuthManager.test.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/rayuHostAuthManager.test.mjs && node --test dist/harnessSession.test.mjs dist/rayuHostAuthManager.test.mjs",
    "test:webview": "vitest run --passWithNoTests",
    "test": "npm run test:host && npm run test:webview",
    "build": "tsc --noEmit && node build.mjs",
    "package": "node package.mjs",
    "package:vsix": "node package.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@rayu-dev/rayucode-sdk": "1.2.0",
    "@rayu-dev/rayucode-ui": "0.1.0",
    "@tanstack/react-query": "^5.76.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^3.4.2",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "unified": "^11.0.5",
    "zod": "^4.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "1.101.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
