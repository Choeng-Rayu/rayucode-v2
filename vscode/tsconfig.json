{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./webview/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "shared/vscodeProtocol.ts",
    "host/harnessExtension.ts",
    "host/harnessSession.ts",
    "host/runtime/**/*.ts",
    "host/bridges/**/*.ts",
    "host/panel/workspacePanelManager.ts",
    "webview/harnessApp.tsx",
    "webview/src/**/*.ts",
    "webview/src/**/*.tsx",
    "test/harnessSession.test.ts",
    "test/runtime/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
