{
  "name": "rayucode",
  "displayName": "Rayucode",
  "description": "Chat with the RayuCode Rust runtime from VS Code.",
  "version": "3.0.0-preview.2",
  "publisher": "RayuCode",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Choeng-Rayu/rayucode-v2"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": ["AI", "Chat"],
  "type": "commonjs",
  "main": "./extension.js",
  "files": ["extension.js", "media", "LICENSE"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Rayucode connects to the Rayu runtime on the workspace host."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "Rayucode",
      "properties": {
        "rayucode.runtime.socketPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Absolute path to the Rayu Harness socket on the workspace host. Leave empty to use the Rayu runtime default."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        { "id": "rayucode", "title": "Rayucode", "icon": "media/icon.svg" }
      ]
    },
    "views": {
      "rayucode": [
        { "id": "rayucode.chat", "name": "Sessions", "type": "webview" }
      ]
    },
    "commands": [
      { "command": "rayucode.newSession", "title": "New Session", "category": "Rayucode", "icon": "$(add)" },
      { "command": "rayucode.resumeSession", "title": "Resume Session", "category": "Rayucode", "icon": "$(history)" }
    ],
    "menus": {
      "view/title": [
        { "command": "rayucode.newSession", "when": "view == rayucode.chat", "group": "navigation@1" },
        { "command": "rayucode.resumeSession", "when": "view == rayucode.chat", "group": "navigation@2" }
      ]
    }
  }
}
