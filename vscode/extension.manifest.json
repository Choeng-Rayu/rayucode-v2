{
  "name": "rayucode",
  "displayName": "RayuCode",
  "description": "RayuCode Rust AI coding engine and multi-agent mission control for VS Code.",
  "version": "3.0.2",
  "publisher": "RayuCode",
  "icon": "media/rayu-fox.png",
  "homepage": "https://rayucode.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Choeng-Rayu/rayucode-v2"
  },
  "bugs": {
    "url": "https://github.com/Choeng-Rayu/rayucode-v2/issues"
  },
  "qna": "marketplace",
  "license": "MIT",
  "galleryBanner": {
    "color": "#11110E",
    "theme": "dark"
  },
  "keywords": ["ai", "coding-agent", "chat", "mcp", "multi-agent"],
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": ["AI", "Chat", "Programming Languages"],
  "type": "commonjs",
  "main": "./extension.js",
  "files": ["extension.js", "media", "LICENSE", "README.md", "CHANGELOG.md"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "RayuCode connects to the local Rayu Rust runtime on the workspace host."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onAuthenticationRequest:rayu",
    "onStartupFinished"
  ],
  "contributes": {
    "icons": {
      "rayucode": {
        "description": "RayuCode Fox brand icon",
        "default": {
          "fontPath": "media/rayucode-icons.woff",
          "fontCharacter": "\\ea01"
        }
      }
    },
    "authentication": [
      {
        "id": "rayu",
        "label": "Rayu"
      }
    ],
    "configuration": {
      "title": "RayuCode",
      "properties": {
        "rayucode.openLocation": {
          "type": "string",
          "enum": ["secondarySidebar", "beside", "editorTab"],
          "default": "secondarySidebar",
          "description": "Where RayuCode opens by default when launched from the Editor Tab Bar icon or contextual actions: Secondary Sidebar (right, Copilot/Claude Code slot), Split Beside Editor, or active Editor Tab."
        },
        "rayucode.showEditorTitleIcon": {
          "type": "boolean",
          "default": true,
          "description": "Display the live RayuCode Fox icon button in the Editor Tab Bar (top-right of open editors)."
        },
        "rayucode.contextActionsAutoSubmit": {
          "type": "boolean",
          "default": false,
          "description": "Automatically submit prompts from contextual actions (Explain Selection, Refactor Selection, Fix with RayuCode Quick Fix, Ask Terminal). When false, prompts are prefilled and focused for 1-Enter confirmation."
        },
        "rayucode.apiSocketPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Absolute path to the Rayu Harness API socket (rayu-api.sock). Leave empty to use RAYU_API_SOCKET or the platform runtime default."
        },
        "rayucode.binaryPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Absolute path to the rayu CLI binary. Leave empty to auto-discover or automatically download the official Rayu engine binary into extension storage."
        },
        "rayucode.autoStartBridge": {
          "type": "boolean",
          "scope": "machine",
          "default": true,
          "description": "Automatically start `rayu --no-update api-bridge` when no running bridge is listening on the API socket."
        },
        "rayucode.autoUpdateEngine": {
          "type": "boolean",
          "scope": "machine",
          "default": true,
          "description": "Automatically check GitHub Releases for newer Rayu engine binaries on startup, extension updates, and every 4 hours, and install verified updates when idle."
        },
        "rayucode.theme": {
          "type": "string",
          "enum": ["auto", "dark", "light", "vscode"],
          "default": "auto",
          "description": "RayuCode theme polarity: follow VS Code dark/light polarity (auto), Warm Graphite Dark (dark), Warm Paper Light (light), or inherit VS Code theme tokens directly (vscode)."
        },
        "rayucode.accent": {
          "type": "string",
          "enum": ["green", "blue"],
          "default": "green",
          "description": "Primary brand accent color: Rayu Green (green) or Ocean Blue (blue)."
        },
        "rayucode.defaultPermissionMode": {
          "type": "string",
          "enum": ["default", "acceptEdits", "plan", "fullManage", "orchestrator"],
          "default": "default",
          "description": "Default permission mode for new RayuCode sessions."
        },
        "rayucode.runtime.socketPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Legacy alias for rayucode.apiSocketPath."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "rayucode",
          "title": "RayuCode",
          "icon": "media/rayu-fox-icon.svg"
        }
      ]
    },
    "views": {
      "rayucode": [
        {
          "id": "rayucode.chat",
          "name": "Workspace",
          "contextualTitle": "RayuCode",
          "type": "webview"
        }
      ]
    },
    "submenus": [
      {
        "id": "rayucode.editorSubmenu",
        "label": "RayuCode",
        "icon": {
          "light": "media/rayu-fox.png",
          "dark": "media/rayu-fox.png"
        }
      }
    ],
    "commands": [
      {
        "command": "rayucode.openFromEditorTitle",
        "title": "Open RayuCode",
        "category": "RayuCode",
        "icon": {
          "light": "media/rayu-fox.png",
          "dark": "media/rayu-fox.png"
        }
      },
      {
        "command": "rayucode.openBeside",
        "title": "Open RayuCode Beside Editor",
        "category": "RayuCode",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "rayucode.newSession",
        "title": "New Session",
        "category": "RayuCode",
        "icon": "$(add)"
      },
      {
        "command": "rayucode.resumeSession",
        "title": "Resume Session",
        "category": "RayuCode",
        "icon": "$(history)"
      },
      {
        "command": "rayucode.openSidebar",
        "title": "Focus RayuCode Sidebar",
        "category": "RayuCode",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "rayucode.openWorkspacePanel",
        "title": "Open Mission Control Panel",
        "category": "RayuCode",
        "icon": "$(link-external)"
      },
      {
        "command": "rayucode.openSwarm",
        "title": "Open Swarm Mission Control",
        "category": "RayuCode",
        "icon": "$(organization)"
      },
      {
        "command": "rayucode.openAgents",
        "title": "Open Agents & Personas",
        "category": "RayuCode",
        "icon": "$(hubot)"
      },
      {
        "command": "rayucode.openAutomations",
        "title": "Open Automations",
        "category": "RayuCode",
        "icon": "$(clock)"
      },
      {
        "command": "rayucode.openPlugins",
        "title": "Open Plugins, MCP & Skills",
        "category": "RayuCode",
        "icon": "$(plug)"
      },
      {
        "command": "rayucode.openBackgroundProcesses",
        "title": "Open Background Processes",
        "category": "RayuCode",
        "icon": "$(terminal)"
      },
      {
        "command": "rayucode.openTerminal",
        "title": "Open Terminal in VS Code",
        "category": "RayuCode",
        "icon": "$(terminal)"
      },
      {
        "command": "rayucode.openBrowser",
        "title": "Open Browser in VS Code",
        "category": "RayuCode",
        "icon": "$(globe)"
      },
      {
        "command": "rayucode.openChanges",
        "title": "Open Changes & Diff Review",
        "category": "RayuCode",
        "icon": "$(git-compare)"
      },
      {
        "command": "rayucode.scmOpenChanges",
        "title": "Review Changes in RayuCode",
        "category": "RayuCode",
        "icon": {
          "light": "media/rayu-fox.png",
          "dark": "media/rayu-fox.png"
        }
      },
      {
        "command": "rayucode.reviewGitDiff",
        "title": "Review Working Tree Diff with RayuCode",
        "category": "RayuCode",
        "icon": "$(git-compare)"
      },
      {
        "command": "rayucode.draftCommitMessage",
        "title": "Draft Commit Message with RayuCode",
        "category": "RayuCode",
        "icon": "$(git-commit)"
      },
      {
        "command": "rayucode.openRemote",
        "title": "Open Remote Access",
        "category": "RayuCode",
        "icon": "$(radio-tower)"
      },
      {
        "command": "rayucode.openSettings",
        "title": "Open RayuCode Settings",
        "category": "RayuCode",
        "icon": "$(settings-gear)"
      },
      {
        "command": "rayucode.sendSelection",
        "title": "Add Selection to RayuCode Context",
        "category": "RayuCode",
        "icon": {
          "light": "media/rayu-fox.png",
          "dark": "media/rayu-fox.png"
        }
      },
      {
        "command": "rayucode.addToContext",
        "title": "Add to RayuCode Context",
        "category": "RayuCode",
        "icon": {
          "light": "media/rayu-fox.png",
          "dark": "media/rayu-fox.png"
        }
      },
      {
        "command": "rayucode.askAboutResource",
        "title": "Ask RayuCode about this...",
        "category": "RayuCode",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "rayucode.explainSelection",
        "title": "Explain Selection with RayuCode",
        "category": "RayuCode",
        "icon": "$(book)"
      },
      {
        "command": "rayucode.refactorSelection",
        "title": "Refactor / Fix Selection with RayuCode",
        "category": "RayuCode",
        "icon": "$(wrench)"
      },
      {
        "command": "rayucode.generateTestsForSelection",
        "title": "Generate Tests with RayuCode",
        "category": "RayuCode",
        "icon": "$(beaker)"
      },
      {
        "command": "rayucode.fixDiagnostic",
        "title": "Fix with RayuCode",
        "category": "RayuCode",
        "icon": {
          "light": "media/rayu-fox.png",
          "dark": "media/rayu-fox.png"
        }
      },
      {
        "command": "rayucode.explainDiagnostic",
        "title": "Explain Error with RayuCode",
        "category": "RayuCode",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "rayucode.askTerminal",
        "title": "Ask RayuCode about Terminal Output",
        "category": "RayuCode",
        "icon": {
          "light": "media/rayu-fox.png",
          "dark": "media/rayu-fox.png"
        }
      },
      {
        "command": "rayucode.fixTerminalError",
        "title": "Fix Terminal Error with RayuCode",
        "category": "RayuCode",
        "icon": "$(wrench)"
      },
      {
        "command": "rayucode.reloadDaemon",
        "title": "Reload Daemon / Restart API Bridge",
        "category": "RayuCode",
        "icon": "$(refresh)"
      },
      {
        "command": "rayucode.updateEngine",
        "title": "Install or Update Rayu Engine",
        "category": "RayuCode",
        "icon": "$(cloud-download)"
      },
      {
        "command": "rayucode.statusBarAction",
        "title": "RayuCode Quick Actions",
        "category": "RayuCode"
      },
      {
        "command": "rayucode.signIn",
        "title": "Sign In to RayuCode",
        "category": "RayuCode",
        "icon": "$(account)"
      },
      {
        "command": "rayucode.signOut",
        "title": "Sign Out of RayuCode",
        "category": "RayuCode",
        "icon": "$(sign-out)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rayucode.openFromEditorTitle",
          "alt": "rayucode.openBeside",
          "when": "config.rayucode.showEditorTitleIcon && activeWebviewPanelId != rayucode.workspace",
          "group": "navigation@1"
        },
        {
          "command": "rayucode.openSidebar",
          "when": "activeWebviewPanelId == rayucode.workspace",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "rayucode.addToContext",
          "when": "resourceScheme == file",
          "group": "1_rayucode@1"
        },
        {
          "command": "rayucode.askAboutResource",
          "when": "resourceScheme == file",
          "group": "1_rayucode@2"
        }
      ],
      "view/title": [
        {
          "command": "rayucode.newSession",
          "when": "view == rayucode.chat",
          "group": "navigation@1"
        },
        {
          "command": "rayucode.openBeside",
          "when": "view == rayucode.chat",
          "group": "navigation@2"
        },
        {
          "command": "rayucode.openSettings",
          "when": "view == rayucode.chat",
          "group": "navigation@3"
        },
        {
          "command": "rayucode.openWorkspacePanel",
          "when": "view == rayucode.chat",
          "group": "1_layout@1"
        },
        {
          "command": "rayucode.openBrowser",
          "when": "view == rayucode.chat",
          "group": "1_tools@1"
        },
        {
          "command": "rayucode.openTerminal",
          "when": "view == rayucode.chat",
          "group": "1_tools@2"
        },
        {
          "command": "rayucode.reloadDaemon",
          "when": "view == rayucode.chat",
          "group": "2_runtime@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "rayucode.editorSubmenu",
          "group": "navigation@1"
        }
      ],
      "rayucode.editorSubmenu": [
        {
          "command": "rayucode.sendSelection",
          "when": "editorHasSelection",
          "group": "1_context@1"
        },
        {
          "command": "rayucode.addToContext",
          "when": "editorTextFocus",
          "group": "1_context@2"
        },
        {
          "command": "rayucode.explainSelection",
          "when": "editorHasSelection",
          "group": "2_actions@1"
        },
        {
          "command": "rayucode.refactorSelection",
          "when": "editorHasSelection",
          "group": "2_actions@2"
        },
        {
          "command": "rayucode.generateTestsForSelection",
          "when": "editorHasSelection",
          "group": "2_actions@3"
        }
      ],
      "explorer/context": [
        {
          "command": "rayucode.addToContext",
          "when": "explorerResourceScheme == file",
          "group": "navigation@2"
        },
        {
          "command": "rayucode.askAboutResource",
          "when": "explorerResourceScheme == file",
          "group": "navigation@3"
        }
      ],
      "terminal/context": [
        {
          "command": "rayucode.askTerminal",
          "group": "1_rayucode@1"
        },
        {
          "command": "rayucode.fixTerminalError",
          "group": "1_rayucode@2"
        }
      ],
      "scm/title": [
        {
          "command": "rayucode.scmOpenChanges",
          "when": "scmProvider == git",
          "group": "navigation@1"
        },
        {
          "command": "rayucode.reviewGitDiff",
          "when": "scmProvider == git",
          "group": "1_rayucode@1"
        },
        {
          "command": "rayucode.draftCommitMessage",
          "when": "scmProvider == git",
          "group": "1_rayucode@2"
        }
      ],
      "commandPalette": [
        {
          "command": "rayucode.fixDiagnostic",
          "when": "false"
        },
        {
          "command": "rayucode.explainDiagnostic",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "rayucode.openFromEditorTitle",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      },
      {
        "command": "rayucode.openBeside",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r"
      },
      {
        "command": "rayucode.openWorkspacePanel",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      },
      {
        "command": "rayucode.sendSelection",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "rayucode.openBackgroundProcesses",
        "key": "alt+shift+b",
        "mac": "alt+shift+b"
      }
    ]
  }
}
