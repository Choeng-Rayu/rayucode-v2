# Copy this file to .env (gitignored) and fill in the values.
# Note: The Rust `rayu` binary reads process env vars and ~/.config/rayucode/*.env
# at runtime — load before running tests with:
#   set -a && source .env && set +a
# Exception: compile-time build flags (such as ENABLE_OTHER_PROVIDER below) are
# read automatically from this repository's .env file by Cargo during compilation.

# --- Compile-Time Provider Mode ---
# Controls whether third-party / non-Rayu providers (OpenAI, Anthropic, OpenRouter,
# Copilot, Gemini, Bedrock, Azure, OpenAI-compatible profiles, etc.) are enabled
# in the compiled binary (default: true).
#   true  = allow logging in with and using Rayu plus all other providers
#   false = Rayu-only build (Rayu Auth OAuth or RAYU_API_KEY only; hides and
#           disables all other providers everywhere in CLI, server, and TUI)
# After changing this value, recompile `rayu` (e.g. `cargo build --release --bin rayu`).
ENABLE_OTHER_PROVIDER=true

# --- Rayu Account & Hosted Gateway Endpoints ---
RAYU_API_URL=https://api.rayucode.com/api
RAYU_GATEWAY_URL=https://gateway.rayucode.com
RAYU_WEB_URL=https://rayucode.com

# --- Rayu Auth Gate ---
# Enforces Rayu account login or RAYU_API_KEY before 3P providers/turns (default: true).
USE_RAYU_OAUTH=true
# RAYU_API_KEY=

# --- Git Commit Co-Author Metadata ---
# Git commit co-author email — shown in the "Co-Authored-By: Rayu Code <model> <email>"
# trailer. Change this when the rayu.dev domain is ready.
RAYU_COMMIT_EMAIL=

# --- Optional Rayu Integration Settings ---
RAYU_STUDIO_URL=https://studio.rayucode.com
RAYU_GITHUB_APP_INSTALL_URL=https://github.com/apps/rayucode-agentic
RAYU_GITHUB_ACTION_REF=Choeng-Rayu/rayu-cli/rayu-action@main
RAYU_GITHUB_ACTION_DOCS_URL=https://rayucode.com/docs

# --- Telemetry (off by default) ---
RAYU_TELEMETRY=0
RAYU_NO_TELEMETRY=1

# --- Optional Test / Sandbox Overrides ---
# RAYU_HOME=
# RAYU_AUTH_CONFIG_DIR=
# RAYU_NO_AUTO_UPDATE=1
# RAYU_PROVIDER=
# RAYU_MODEL=
